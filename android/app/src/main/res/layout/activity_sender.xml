<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:tint="#00C853"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="SENDER PANEL"
            android:textColor="#00C853"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAFTAR SENDER"
                android:textColor="#00C853"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_info"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRIVATE"
                    android:textColor="#000000"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvPrivateStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Kosong"
                    android:textColor="#FF1744"
                    android:textSize="11sp"/>

                <Button
                    android:id="@+id/btnDaftarPrivate"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="DAFTAR SENDER PRIVATE"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_green"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_info"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GLOBAL"
                    android:textColor="#000000"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvGlobalStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● 1 Aktif"
                    android:textColor="#00C853"
                    android:textSize="11sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAFTAR SENDER BARU"
                android:textColor="#00C853"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>

            <EditText
                android:id="@+id/etNomorSender"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Contoh: 62812xxxxxxxx"
                android:textColorHint="#888888"
                android:textColor="#000000"
                android:background="@drawable/bg_edittext_white"
                android:padding="14dp"
                android:layout_marginTop="8dp"
                android:inputType="phone"/>

            <Button
                android:id="@+id/btnKirimKode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="KIRIM KODE"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_green"
                android:layout_marginTop="12dp"/>

            <LinearLayout
                android:id="@+id/layoutKode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_info"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KODE VERIFIKASI"
                    android:textColor="#00C853"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvKode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="------"
                    android:textColor="#000000"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="12dp"/>

                <Button
                    android:id="@+id/btnSalinKode"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="SALIN KODE"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_green"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>