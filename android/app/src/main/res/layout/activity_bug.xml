<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:tint="#00C853"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="BUG PANEL"
            android:textColor="#00C853"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"/>

        <TextView
            android:id="@+id/tvSenderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 1 Online"
            android:textColor="#00C853"
            android:textSize="12sp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOMOR TARGET"
                android:textColor="#00C853"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etTarget"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="62xxxxxxxxxx"
                android:textColorHint="#888888"
                android:textColor="#000000"
                android:background="@drawable/bg_edittext_white"
                android:padding="14dp"
                android:layout_marginTop="8dp"
                android:inputType="phone"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PILIH BUG"
                android:textColor="#00C853"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>

            <Spinner
                android:id="@+id/spinnerBug"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_edittext_white"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/btnLaunch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🚀 LAUNCH ATTACK"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/bg_button_green"
                android:layout_marginTop="28dp"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>